{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": ["nodejs@24"],
  "shell": {
    "init_hook": ["node --version", "npm --version"],
    "scripts": {
      "install": "npm install",
      "dev": "npm run dev",
      "build": "npm run build",
      "test": "npm test",
      "test:e2e": "npm run test:e2e"
    }
  }
}
