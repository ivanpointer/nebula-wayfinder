# Copy to .env and fill in values matching your neocortex (second-brain) instance.

# Neo4j Bolt connection (neocortex's local Neo4j).
# The second-brain compose defaults to NEO4J_PASSWORD=changeme unless
# you override it in second-brain/.env.
VITE_NEO4J_URI=bolt://localhost:7687
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=changeme
